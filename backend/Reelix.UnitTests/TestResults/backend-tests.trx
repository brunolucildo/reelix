info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@accountId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT count(*)::int&#xD;
      FROM (&#xD;
          SELECT DISTINCT c0.provider AS "Provider", c.genre_id AS "GenreId"&#xD;
          FROM tracking_records AS t&#xD;
          INNER JOIN catalog_reference_genres AS c ON t.target_id = c.catalog_reference_id&#xD;
          INNER JOIN catalog_external_references AS c0 ON c.catalog_reference_id = c0.id&#xD;
          WHERE t.account_id = @accountId AND t.item_type = 'movie'&#xD;
