      FROM tracking_records AS t&#xD;
      WHERE t.account_id = @accountId AND t.item_type = 'movie' AND NOT EXISTS (&#xD;
          SELECT 1&#xD;
          FROM catalog_reference_genres AS c&#xD;
          WHERE c.catalog_reference_id = t.target_id)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@accountId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT count(*)::int AS "ItemsWithRuntime", COALESCE(sum(s.runtime_minutes), 0)::int AS "EstimatedMinutes", max(s.metadata_version) AS "MetadataVersion", max(s.metadata_updated_at) AS "MetadataUpdatedAt"&#xD;
      FROM (&#xD;
          SELECT c.metadata_updated_at, c.metadata_version, c.runtime_minutes, 1 AS "Key"&#xD;
          FROM tracking_records AS t&#xD;
          INNER JOIN catalog_external_references AS c ON t.target_id = c.id&#xD;
          WHERE t.account_id = @accountId AND t.item_type IN ('movie', 'episode') AND c.runtime_minutes IS NOT NULL AND c.runtime_minutes &gt; 0 AND c.runtime_minutes &lt;= 1440&#xD;
      ) AS s&#xD;
      GROUP BY s."Key"&#xD;
      LIMIT 2&#xD;
