{
  "expo": {
    "name": "Reelix",
    "slug": "reelix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icons/app-icon.png",
    "scheme": "reelix",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand/app-icons/app-icon.png"
    },
    "android": {
      "package": "com.brunolucildo.reelix",
      "adaptiveIcon": {
        "backgroundColor": "#080B0F",
        "foregroundImage": "./assets/brand/app-icons/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/brand/app-icons/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withDevelopmentCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B0F",
          "image": "./assets/brand/logos/logo-vertical.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d0b9bd24-645e-43d6-8c70-7d7829ba8019"
      }
    },
    "owner": "brunolucildo"
  }
}
